{
  "name": "js-priority-queue",
  "version": "1.0.0",
  "description": "A performant generic Priority Queue implementation using Binary Heap",
  "main": "src/PriorityQueue.js",
  "types": "src/PriorityQueue.d.ts",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "node benchmarks/perf.js",
    "r_bench": "node benchmarks/rigorous_perf.js",
    "r_comp_bench": "node benchmarks/rigorous_comparator_perf.js",
    "r_obj_bench": "node benchmarks/rigorous_perf_objects.js"
  },
  "keywords": [
    "priority-queue",
    "heap",
    "binary-heap",
    "data-structure",
    "algorithm"
  ],
  "author": "haron-qa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haron-qa/jsPriorityQueue.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/PriorityQueue.d.ts",
      "import": "./src/PriorityQueue.js"
    }
  },
  "files": [
    "src"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "fastpriorityqueue": "^0.7.5",
    "flatqueue": "^3.0.0",
    "heap-js": "^2.7.1",
    "heapify": "^0.6.0",
    "tinyqueue": "^3.0.0",
    "vitest": "^4.0.16"
  }
}